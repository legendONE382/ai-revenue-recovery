# ═══════════════════════════════════════════════════════════════════════════════
#  Inbox Revenue Intelligence — environment configuration
#
#  1. cp .env.example .env
#  2. node scripts/generate-secrets.mjs      ← prints TOKEN_ENCRYPTION_KEY + CRON_SECRET
#  3. Fill in the [REQUIRED] values, plus any optional features you want.
#  4. node scripts/migrate.mjs               ← creates/updates database tables
#
#  After deploying, open Settings › Deployment status in the app to confirm what's configured.
#  Never commit the filled-in .env file.
# ═══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────── Core ───────────────────────────────

# [REQUIRED] Postgres connection string.
#   Supabase: Project Settings › Database › Connection string › "Transaction pooler" (port 6543)
#   Neon:     Dashboard › Connection Details (pooled connection)
#   Docker:   leave as-is when using docker-compose (overridden there)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# [OPTIONAL] TLS for the database connection:
#   require    = encrypted + verify certificate (Neon, most managed Postgres)
#   no-verify  = encrypted, skip CA verification (Supabase pooler unless you install its CA).
#                If you use this, REMOVE any ?sslmode=... from DATABASE_URL (the URL takes precedence).
#   (empty)    = follow DATABASE_URL (local / Docker)
DATABASE_SSL=

# [OPTIONAL] Max DB connections per server instance. Use 1–3 on serverless (Vercel), 10 on a server.
DATABASE_POOL_MAX=10

# [REQUIRED] Public base URL of the deployed app — https, no trailing slash.
#   Used for the Google OAuth redirect, email links and CSRF origin checks.
APP_URL=http://localhost:3000

# [REQUIRED] 32-byte key for AES-256-GCM encryption of Google tokens and users' AI API keys.
#   Generate: node scripts/generate-secrets.mjs
#   Store a backup in your password manager. If you lose or change it, every user must reconnect Gmail.
TOKEN_ENCRYPTION_KEY=

# [REQUIRED] Secret that authorises the background scheduler to call /api/cron/tick (min 16 chars).
#   Generate: node scripts/generate-secrets.mjs
#   Use the same value in GitHub Actions secrets / your cron service / scripts/worker.mjs.
CRON_SECRET=

# [OPTIONAL] Set to 1 ONLY when running a production build over plain http (e.g. docker-compose on
#   localhost). Leave empty on any real https deployment.
INSECURE_COOKIES=

# [OPTIONAL] Shown on the Terms and Privacy pages (needed for Google verification).
OPERATOR_NAME=
CONTACT_EMAIL=


# ───────────────────── Google OAuth / Gmail (real mailboxes) ─────────────────────
# Without these, the app runs fully with the sample inbox (demo mode).
#
# Google Cloud Console → enable "Gmail API" → OAuth consent screen (External; add yourself as a
# Test user) → Credentials → Create OAuth client ID → "Web application":
#   Authorised redirect URI:  ${APP_URL}/api/integrations/google/callback
#   e.g. https://revenue.example.com/api/integrations/google/callback
# Until Google verifies the app (restricted scopes + CASA assessment), only listed test users
# (max 100) can connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [OPTIONAL] 0 = don't request gmail.compose (removes the "Create Gmail draft" button's ability).
GMAIL_ENABLE_DRAFTS=1


# ─────────────── Gmail push notifications via Cloud Pub/Sub (optional) ───────────────
# Without these, new mail is picked up by polling every 15 minutes (requires the scheduler).
#
# 1. Pub/Sub → create topic, e.g. projects/my-project/topics/gmail-push
# 2. Topic › Permissions › add principal gmail-api-push@system.gserviceaccount.com as "Pub/Sub Publisher"
# 3. Create subscription: Delivery type "Push", endpoint ${APP_URL}/api/webhooks/gmail
#    Enable authentication, choose a service account, set Audience = the endpoint URL.
GMAIL_PUBSUB_TOPIC=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Optional extra shared secret: if set, append ?token=<value> to the push endpoint URL.
PUBSUB_VERIFICATION_TOKEN=


# ─────────────────────── Email delivery (optional, recommended) ───────────────────────
# Enables password-reset emails and notification emails. Uses Resend (free: 3,000/month).
# resend.com → verify your domain → API Keys → create key.
RESEND_API_KEY=
# Must be on your verified domain.
EMAIL_FROM=Inbox Revenue Intelligence <notifications@yourdomain.com>
EMAIL_REPLY_TO=


# ─────────────────────────── AI providers (all optional) ───────────────────────────
# Used ONLY for workspaces that opt in to AI processing (off by default). Without any key, all
# detection, drafts (templates) and assistant answers still work deterministically.
# Users can also add their own keys in Settings (stored encrypted), which take precedence.
# Cheapest good options: Gemini (aistudio.google.com) or Groq (console.groq.com) free tiers —
# note some free tiers may use inputs to improve models; disclose this or use paid keys.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# [OPTIONAL] Per-task model overrides: AI_MODEL_<GEMINI|GROQ|MISTRAL|OPENAI>_<CLASSIFY|DRAFT|ASSISTANT>
# AI_MODEL_GEMINI_CLASSIFY=gemini-2.5-flash-lite
# AI_MODEL_GROQ_DRAFT=llama-3.3-70b-versatile
